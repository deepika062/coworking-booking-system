# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the React app)
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL 13+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coworking

# --- Auth ---
# Use a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Short-lived access token (jsonwebtoken / ms format: 15m, 1h, ...)
JWT_ACCESS_TTL=15m
# Refresh token lifetime (rotated on every use)
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false

# --- Rate limiting for /auth/login and /auth/register ---
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=10

# --- Business rules ---
BUSINESS_TIMEZONE=Asia/Kolkata
OPENING_HOUR=8
CLOSING_HOUR=20
SLOT_MINUTES=30
MAX_ADVANCE_DAYS=60

# Insert demo users + spaces on startup (idempotent)
SEED_ON_START=true
