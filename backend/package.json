{
  "name": "coworking-booking-backend",
  "version": "1.0.0",
  "description": "Co-working space desk & room booking API (Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
